// Schema Prisma — LPC
// Modelos alineados 1:1 con lpc_tablas.sql
// OCP: para agregar modelos nuevos solo se añaden al final

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── USUARIOS ──────────────────────────────────────────────
model Usuario {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre           String   @db.VarChar(100)
  correo           String   @unique @db.VarChar(255)
  contrasenaHash   String?  @map("contrasena_hash")
  proveedorOauth   String?  @map("proveedor_oauth") @db.VarChar(20)
  idProveedorOauth String?  @map("id_proveedor_oauth") @db.VarChar(255)
  verificado       Boolean  @default(false)
  creadoEn         DateTime @default(now()) @map("creado_en")
  actualizadoEn    DateTime @default(now()) @updatedAt @map("actualizado_en")

  sesiones           Sesion[]
  tokensRecuperacion TokenRecuperacion[]
  miembrosGrupo      MiembroGrupo[]
  gastosPagados      Gasto[]             @relation("GastoPagador")
  divisionesGasto    DivisionGasto[]
  deudasComoDeudor   Deuda[]             @relation("DeudaDeudor")
  deudasComoAcreedor Deuda[]             @relation("DeudaAcreedor")
  notificaciones       Notificacion[]
  invitacionesEnviadas Invitacion[] @relation("InvitacionInvitador")
  votacionesCreadas    Votacion[]   @relation("VotacionCreador")
  votosEmitidos        VotoIndividual[]
  comprobantes       ComprobantePago[]

  @@map("usuarios")
}

// ── TOKENS DE RECUPERACIÓN ────────────────────────────────
model TokenRecuperacion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idUsuario String   @map("id_usuario") @db.Uuid
  token     String   @unique
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@map("tokens_recuperacion")
}

// ── SESIONES (refresh tokens) ─────────────────────────────
model Sesion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idUsuario String   @map("id_usuario") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiraEn  DateTime @map("expira_en")
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@map("sesiones")
}

// ── GRUPOS DE VIAJE ───────────────────────────────────────
model Grupo {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                String   @db.VarChar(100)
  destino               String   @db.VarChar(100)
  fechaInicio           DateTime @map("fecha_inicio") @db.Date
  fechaFin              DateTime @map("fecha_fin") @db.Date
  monedaBase            String   @default("CLP") @map("moneda_base") @db.VarChar(10)
  presupuestoPorPersona Decimal? @map("presupuesto_por_persona") @db.Decimal(12, 2)
  umbralAlerta          Decimal? @map("umbral_alerta") @db.Decimal(5, 2)
  estado                String   @default("activo") @db.VarChar(10)
  creadoEn              DateTime @default(now()) @map("creado_en")
  actualizadoEn         DateTime @default(now()) @updatedAt @map("actualizado_en")

  miembros     MiembroGrupo[]
  gastos       Gasto[]
  deudas       Deuda[]
  invitaciones Invitacion[]
  votaciones   Votacion[]

  @@map("grupos")
}

// ── MIEMBROS DE GRUPO ─────────────────────────────────────
model MiembroGrupo {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idGrupo   String   @map("id_grupo") @db.Uuid
  idUsuario String   @map("id_usuario") @db.Uuid
  rol       String   @default("miembro") @db.VarChar(10)
  unidoEn   DateTime @default(now()) @map("unido_en")

  grupo   Grupo   @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@unique([idGrupo, idUsuario])
  @@map("miembros_grupo")
}

// ── GASTOS ────────────────────────────────────────────────
model Gasto {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idGrupo       String   @map("id_grupo") @db.Uuid
  idPagador     String   @map("id_pagador") @db.Uuid
  monto         Decimal  @db.Decimal(12, 2)
  descripcion   String   @db.VarChar(255)
  categoria     String   @db.VarChar(50)
  urlBoleta     String?  @map("url_boleta")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en")

  grupo      Grupo           @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  pagador    Usuario         @relation("GastoPagador", fields: [idPagador], references: [id])
  divisiones DivisionGasto[]

  @@map("gastos")
}

// ── DIVISIONES DE GASTO ───────────────────────────────────
model DivisionGasto {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idGasto       String  @map("id_gasto") @db.Uuid
  idUsuario     String  @map("id_usuario") @db.Uuid
  montoAsignado Decimal @map("monto_asignado") @db.Decimal(12, 2)
  tipoDivision  String  @map("tipo_division") @db.VarChar(15)

  gasto   Gasto   @relation(fields: [idGasto], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [idUsuario], references: [id])

  @@unique([idGasto, idUsuario])
  @@map("divisiones_gasto")
}

// ── DEUDAS ────────────────────────────────────────────────
model Deuda {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idGrupo       String   @map("id_grupo") @db.Uuid
  idDeudor      String   @map("id_deudor") @db.Uuid
  idAcreedor    String   @map("id_acreedor") @db.Uuid
  monto         Decimal  @db.Decimal(12, 2)
  saldada       Boolean  @default(false)
  estado        String   @default("pendiente") @db.VarChar(30)
  pagadaEn      DateTime? @map("pagada_en")
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en")

  grupo    Grupo   @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  deudor   Usuario @relation("DeudaDeudor", fields: [idDeudor], references: [id])
  acreedor Usuario @relation("DeudaAcreedor", fields: [idAcreedor], references: [id])
  votaciones Votacion[]
  comprobantes ComprobantePago[]

  @@map("deudas")
}

// ── COMPROBANTES DE PAGO ────────────────────────────────────
model ComprobantePago {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idDeuda     String   @map("id_deuda") @db.Uuid
  idUsuario   String   @map("id_usuario") @db.Uuid
  urlArchivo  String   @map("url_archivo") @db.VarChar(500)
  tipoArchivo String   @map("tipo_archivo") @db.VarChar(50)
  rut         String   @db.VarChar(20)
  estado      String   @default("pendiente") @db.VarChar(20)
  aceptadoEn  DateTime? @map("aceptado_en")
  rechazadoEn DateTime? @map("rechazado_en")
  creadoEn    DateTime @default(now()) @map("creado_en")

  deuda   Deuda   @relation(fields: [idDeuda], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [idUsuario], references: [id])

  @@map("comprobantes_pago")
}

// ── NOTIFICACIONES ────────────────────────────────────────
model Notificacion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idUsuario String   @map("id_usuario") @db.Uuid
  tipo      String   @db.VarChar(30)
  metadata  Json     @default("{}")
  leida     Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@map("notificaciones")
}

// ── INVITACIONES ──────────────────────────────────────────
model Invitacion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idGrupo        String   @map("id_grupo") @db.Uuid
  idInvitador    String?  @map("id_invitador") @db.Uuid
  correoInvitado String?  @map("correo_invitado") @db.VarChar(255)
  token          String   @unique
  tipo           String   @default("enlace") @db.VarChar(10)
  expiraEn       DateTime @map("expira_en")
  usado          Boolean  @default(false)
  creadoEn       DateTime @default(now()) @map("creado_en")

  grupo     Grupo    @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  invitador Usuario? @relation("InvitacionInvitador", fields: [idInvitador], references: [id], onDelete: SetNull)

  @@map("invitaciones")
}

// ── VOTACIONES ────────────────────────────────────────────
model Votacion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idGrupo     String   @map("id_grupo") @db.Uuid
  idDeuda     String   @map("id_deuda") @db.Uuid
  idCreador   String   @map("id_creador") @db.Uuid
  tipo        String   @db.VarChar(15)
  estado      String   @default("activa") @db.VarChar(10)
  resultado   String?  @db.VarChar(10)
  creadoEn    DateTime @default(now()) @map("creado_en")
  resueltaEn  DateTime? @map("resuelta_en")

  grupo   Grupo   @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  deuda   Deuda   @relation(fields: [idDeuda], references: [id], onDelete: Cascade)
  creador Usuario @relation("VotacionCreador", fields: [idCreador], references: [id])
  votos   VotoIndividual[]

  @@map("votaciones")
}

model VotoIndividual {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idVotacion  String   @map("id_votacion") @db.Uuid
  idUsuario   String   @map("id_usuario") @db.Uuid
  decision    String   @db.VarChar(10)
  creadoEn    DateTime @default(now()) @map("creado_en")

  votacion Votacion @relation(fields: [idVotacion], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [idUsuario], references: [id])

  @@unique([idVotacion, idUsuario])
  @@map("votos_individuales")
}
